{
  "name": "bagbigbug",
  "version": "0.1.0",
  "description": "Opt-in bug-bounty workflow skills for DeepSeek Harness. Preserves the upstream prompt pack and exposes fourteen phase prompts through explicit user invocation.",
  "license": "MIT",
  "author": "mulqizamzam",
  "repository": {
    "type": "git",
    "url": "https://github.com/mulqizamzam/mulqi-bagbigbug.git"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "src/",
    "cordis.patch.yml",
    "icon.svg",
    "locale/",
    "instructions/",
    "source/original/",
    "source/original-dotgitignore.txt",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs/source-to-target-manifest.json",
    "docs/reconciliation-report.md",
    "repo-inventory.md",
    "capability-map.md",
    "ledger.md",
    "verification.md",
    "CONVERSION_REPORT.md",
    "scripts/validate_source_manifest.py",
    "scripts/live-harness-verify.mjs"
  ],
  "scripts": {
    "verify": "python3 scripts/validate_source_manifest.py && node tests/plugin-smoke.mjs",
    "verify:live": "node scripts/live-harness-verify.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.2"
  },
  "dsh": {
    "engines": {
      "dsh": "0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
